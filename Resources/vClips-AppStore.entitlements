<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mandatory for Mac App Store distribution. vClips needs nothing else:
         clipboard read/write and RegisterEventHotKey are sandbox-allowed, and
         this build is copy-only — it uses no AX permission at all.
         TEAM_ID/BUNDLE_ID placeholders are filled in by scripts/appstore.sh. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>TEAM_ID.BUNDLE_ID</string>
    <key>com.apple.developer.team-identifier</key>
    <string>TEAM_ID</string>
</dict>
</plist>
